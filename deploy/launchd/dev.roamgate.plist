<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.roamgate</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; if [ -f "$HOME/.config/roamgate/roamgate.env" ]; then . "$HOME/.config/roamgate/roamgate.env"; fi; set +a; exec "$HOME/.local/bin/roamgate"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/roamgate.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/roamgate.stderr.log</string>
</dict>
</plist>
