[Unit]
Description=Roamgate
Documentation=https://github.com/powerfooI/roamgate
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/herdr-gui/herdr-gui.env
ExecStart=%h/.local/bin/roamgate
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=default.target
